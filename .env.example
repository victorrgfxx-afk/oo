# ---------------------------------------------------------------------------
# Claude - agentul care scrie auditul
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Google - alege UNA dintre cele doua metode de autentificare
# ---------------------------------------------------------------------------

# Metoda A: service account (recomandat cu Google Workspace + Shared Drive).
# Continutul JSON-ului descarcat din Google Cloud, pe un singur rand,
# sau acelasi JSON codificat base64.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Metoda B: OAuth pe contul vostru (recomandat pe Gmail personal).
# Se foloseste doar daca GOOGLE_SERVICE_ACCOUNT_JSON e gol.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Folderul din Drive in care se creeaza cate un subfolder per client.
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# Foaia de calcul care tine loc de baza de date.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Leads

# ---------------------------------------------------------------------------
# Email (Brevo)
# ---------------------------------------------------------------------------
BREVO_API_KEY=
MAIL_FROM_EMAIL=audit@domeniul-tau.ro
MAIL_FROM_NAME=Numele agentiei
# Unde ajung notificarile interne (lead nou, draft gata, eroare).
TEAM_EMAIL=echipa@domeniul-tau.ro

# ---------------------------------------------------------------------------
# Panou intern si cron
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=schimba-parola-asta
CRON_SECRET=un-sir-lung-si-aleator

# ---------------------------------------------------------------------------
# Reglaje (toate au valori implicite rezonabile)
# ---------------------------------------------------------------------------
# La cate ore dupa cerere pleaca auditul catre client.
DELIVERY_DELAY_HOURS=48
# Cate capturi trimitem modelului per client.
MAX_SCREENSHOTS=8
# Cate leaduri intra intr-o rulare de cron.
MAX_LEADS_PER_TICK=15
# Adresa publica, folosita in linkurile din email (pe Vercel se deduce singura).
PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# "Antrenarea" agentului fara deploy (optional)
# ID-ul unui Google Doc al carui text se adauga la playbook-ul nisei.
# ---------------------------------------------------------------------------
KB_DOC_ID_BEAUTY=
KB_DOC_ID_HORECA=
KB_DOC_ID_FITNESS=
KB_DOC_ID_IMOBILIARE=
